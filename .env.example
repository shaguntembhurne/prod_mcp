# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# Leave blank to use SQLite (default for local dev).
# For PostgreSQL set: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=yourpassword
DEFAULT_FROM_EMAIL=MIT University <noreply@mituniversity.edu.in>
